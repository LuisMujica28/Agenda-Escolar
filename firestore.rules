rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD Y PERMISOS
    // =====================================================================

    // Verificar si el usuario ha iniciado sesión con Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Verificar si el correo pertenece al dominio oficial institucional o cuentas maestras
    function isInstitutionalDomain() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*@inas[.]edu[.]co$') || 
        request.auth.token.email == 'admin@colegio.com' ||
        request.auth.token.email == 'digaluju@gmail.com'
      );
    }

    // Obtener los datos del usuario en la colección 'users' si existe
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar rol de Administrador
    function isAdmin() {
      return isInstitutionalDomain() && (
        request.auth.token.email == 'admin@colegio.com' || 
        request.auth.token.email == 'digaluju@gmail.com' ||
        request.auth.token.email == 'rectoria@inas.edu.co' ||
        request.auth.token.email == 'secretaria@inas.edu.co' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }

    // Verificar rol de Docente
    function isTeacher() {
      return isInstitutionalDomain() && (
        isAdmin() || 
        request.auth.token.email in [
          'yulimatematicas@inas.edu.co',
          'alexandralenguaje@inas.edu.co',
          'carlosgomez@inas.edu.co',
          'carolinaartes@inas.edu.co',
          'carolinaorientacion@inas.edu.co',
          'estebanm@inas.edu.co',
          'florciencias@inas.edu.co',
          'freddypacheco@inas.edu.co',
          'ibonciencias@inas.edu.co',
          'josejimenez@inas.edu.co',
          'kathelenguaje@inas.edu.co',
          'lauraflorez@inas.edu.co',
          'luiscarvajal@inas.edu.co',
          'luismatematicas@inas.edu.co',
          'maritzaingles@inas.edu.co',
          'merlyetica@inas.edu.co',
          'orientacion@inas.edu.co',
          'soniaingles@inas.edu.co'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'teacher')
      );
    }

    // =====================================================================
    // REGLAS POR COLECCIÓN
    // =====================================================================

    // 1. USUARIOS (users)
    match /users/{userId} {
      allow read: if isInstitutionalDomain();
      allow create, update: if isInstitutionalDomain() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. ESTUDIANTES (students)
    match /students/{studentId} {
      allow read: if isInstitutionalDomain();
      allow write: if isAdmin();
    }

    // 3. CALIFICACIONES Y BOLETINES (grades)
    match /grades/{gradeId} {
      allow read: if isInstitutionalDomain();
      allow write: if isTeacher();
    }

    // 4. OBSERVADOR DEL ALUMNO (observation_logs)
    match /observation_logs/{logId} {
      allow read: if isInstitutionalDomain();
      allow create: if isTeacher();
      allow delete: if isAdmin();
      allow update: if isTeacher() || isInstitutionalDomain();
    }

    // 5. CIRCULARES Y COMUNICADOS (circulars)
    match /circulars/{circularId} {
      allow read: if isInstitutionalDomain();
      allow write: if isAdmin();
    }

    // 6. CURSOS Y ASIGNATURAS (courses)
    match /courses/{courseId} {
      allow read: if isInstitutionalDomain();
      allow write: if isAdmin();
    }

    // 7. FORMULARIOS DE ASPIRANTES Y MATRÍCULAS (aspirants)
    match /aspirants/{aspirantId} {
      allow read, write: if isAdmin();
    }

    // 8. ASISTENCIA DIARIA (attendance)
    match /attendance/{attendanceId} {
      allow read: if isInstitutionalDomain();
      allow write: if isTeacher();
    }

    // 9. TAREAS Y ACTIVIDADES ESCOLARES (tasks)
    match /tasks/{taskId} {
      allow read: if isInstitutionalDomain();
      allow write: if isTeacher();
    }

    // 10. MENSAJERÍA INSTITUCIONAL (messages)
    match /messages/{messageId} {
      allow read, create: if isInstitutionalDomain();
      allow update, delete: if isTeacher() || isAdmin();
    }

    // 11. DOCENTES Y PERSONAL INSTITUCIONAL (teachers)
    match /teachers/{teacherId} {
      allow read: if isInstitutionalDomain();
      allow write: if isAdmin();
    }

    // 12. CONFIGURACIÓN DEL SISTEMA (config)
    match /config/{configId} {
      allow read: if isInstitutionalDomain();
      allow write: if isAdmin();
    }

    // 13. AUDITORÍA Y ACTIVIDAD (audit_logs)
    match /audit_logs/{logId} {
      allow read, write: if isInstitutionalDomain();
    }

    // REGLA POR DEFECTO: Denegar cualquier otra operación no autorizada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
